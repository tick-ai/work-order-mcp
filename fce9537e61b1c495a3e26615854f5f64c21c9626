}`).join(',')}}`;\n};\nconst documentHash = (body) => createHash('sha256').update(JSON.stringify(serialize(body)), 'utf8').digest('hex');\n\n// A party is a key: made once, kept by the doer, never sent anywhere.\nconst home = process.env.TICK_ID_HOME ?? join(homedir(), '.tick-id');\nmkdirSync(home, { recursive: true });\nconst keyFile = join(home, 'id.pem');\nif (!existsSync(keyFile)) {\n  const { privateKey } = generateKeyPairSync('ed25519');\n  writeFileSync(keyFile, privateKey.export({ type: 'pkcs8', format: 'pem' }), { mode: 0o600 });\n}\nconst privateKey = createPrivateKey(readFileSync(keyFile));\nconst spki = createPublicKey(privateKey).export({ type: 'spki', format: 'der' });\nconst keyId = createHash('sha256').update(spki).digest('hex').slice(0, 16);\n\nconst git = (...a) => execFileSync('git', ['-C', resolve(repo), ...a], { encoding: 'utf8' }).trim();\nconst order = JSON.parse(readFileSync(orderFile, 'utf8'));\nconst base = order.order.base;\nconst commit = git('rev-parse', commitish);\nconst tree = git('rev-parse', `${commit}^{tree}`);\ngit('merge-base', '--is-ancestor', base, commit);\n\nconst delivery = {\n  order_hash: order.content_hash,\n  repository: order.order.repository,\n  base,\n  commit,\n  tree,\n  tries: [{ agent, model, minutes: Number.isFinite(minutes) ? minutes : null, cents: null, cost: 'unknown' }],\n};\nconst deliveryId = randomUUID();\nconst contentHash = documentHash(delivery);\nconst signature = sign(null, Buffer.from(`tick-delivery:v1:${deliveryId}:${contentHash}`, 'utf8'), privateKey).toString('base64');\nconst out = resolve(outFolder);\nmkdirSync(out, { recursive: true });\nwriteFileSync(join(out, 'delivery.json'), `${JSON.stringify({\n  schema: 'tick.delivery.v1',\n  alg: 'ed25519',\n  issued_at: new Date().toISOString(),\n  coordinator: `doer:${keyId}`,\n  delivery_id: deliveryId,\n  delivery,\n  content_hash: contentHash,\n  key: spki.toString('base64'),\n  key_id: keyId,\n  signature,\n  limits: [\n    'The signature proves the holder of the carried key handed this in. It says what the doer states, not that the work is right.',\n    'The carried key is the doer\\'s only if the reader already holds that key_id from somewhere else.',\n    'Minutes and agent are the doer\\'s own word.',\n  ],\n}, null, 2)}\\n`);\ngit('update-ref', 'refs/tick/delivery', commit);\ngit('bundle', 'create', join(out, 'work.bundle'), `${base}..refs/tick/delivery`);\ngit('update-ref', '-d', 'refs/tick/delivery');\nconsole.log(`handed in ${commit.slice(0, 12)} under key ${keyId}: ${out}`);"},"order_id":"01a190ea-dc5a-7606-9c85-bd6db3b1b6c1","schema":"tick.work-order.v1","signature":"2JHSlAIv2/venW68r1Z1AFKtfW74fdGmXnxbwCgttL5zpErquk8JzHWtYZPIlvmiwe4fqcbXnxm3zF9c+WSGDQ=="}},"receipt_id":"01a190ea-dc5a-7606-9c85-bd6db3b1b6c1","schema":"tick.receipt.v2","signature":"gsrS+IHzWV1Ghe17YwluT2CcR99DxnaYR+FFMyduwf7UiFiWal3AOwrNo7F+HRbq9Kxladwtq6ZsEf947xeFCQ=="}]}
